    <muscle force="767.8889999999999" lengthrange="0.2 0.25" name="tric_lat_avg" range="0.7 .9" tendon="tric_lat_avg"/>
    <muscle force="430.5" lengthrange="0.019 0.048" name="anconeus_avg" range="0.7 .9" tendon="anconeus_avg"/>
    <muscle force="443.25299999999993" lengthrange="0.21 0.31" name="bic_b_avg" range="0.95 1.2" tendon="bic_b_avg"/>
    <muscle force="309.276" lengthrange="0.29 0.38" name="bic_l" range="0.95 1.2" tendon="bic_l"/>
